{
  "name": "private-capture-md",
  "version": "0.1.0",
  "description": "A local-first, self-hostable Markdown inbox for Obsidian-compatible vaults.",
  "author": "Shivani Gupta",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/shivanigupta-dev/private-capture-md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivanigupta-dev/private-capture-md.git"
  },
  "bugs": {
    "url": "https://github.com/shivanigupta-dev/private-capture-md/issues"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "private-capture": "./src/cli/main.ts"
  },
  "files": [
    "src",
    "web",
    "deploy",
    "docs",
    "CHANGELOG.md",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node src/cli/main.ts serve",
    "start": "node src/cli/main.ts serve",
    "test": "node --test tests/*.test.ts",
    "check": "node --check web/app.js && node --check web/health.js && node --test tests/*.test.ts"
  },
  "keywords": [
    "markdown",
    "obsidian",
    "notes",
    "local-first",
    "self-hosted",
    "pwa",
    "health-journal"
  ]
}
